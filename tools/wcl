#!/usr/bin/env bash
# Run the VC++ 5.0 compiler (SP3 by default) under Wine, or as tools/wlink,
# tools/wrc and tools/wcvtres its linker and resource tools.
# Usage: tools/wcl [cl.exe args...]    e.g. tools/wcl /c /O2 src/foo.cpp
# Set BT_TOOLCHAIN=msvc5-rtm to use the unpatched compiler instead.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$ROOT/tools/wineenv.sh"
[ -f "$TC/BIN/CL.EXE" ] || { echo "Toolchain missing, run tools/setup_toolchain.sh" >&2; exit 1; }

tool="$(basename "$0")"
nologo=/nologo
case "$tool" in
    wlink) exe=LINK.EXE ;;
    wcvtres) exe=CVTRES.EXE ;;
    # The resource compiler prints its banner whatever it is given: it has no /nologo.
    wrc) exe=RC.EXE nologo= ;;
    *) exe=CL.EXE ;;
esac
# Wine's server and helper processes inherit the compiler's stdout and stderr
# and hold them until they exit, so a caller capturing the output through a
# pipe (check.py) waited about 1.3 s per compile. Send the output to a file
# instead, and print it once the compiler has exited.
out="$(mktemp)"
trap 'rm -f "$out"' EXIT
rc=0
wine "$(winpath "$TC/BIN")/$exe" $nologo "$@" >"$out" 2>&1 </dev/null || rc=$?
cat "$out"
exit "$rc"
