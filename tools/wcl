#!/usr/bin/env bash
# Run the VC++ 5.0 compiler (SP3 by default) under Wine.
# Usage: tools/wcl [cl.exe args...]    e.g. tools/wcl /c /O2 src/foo.cpp
# Set BT_TOOLCHAIN=msvc5-rtm to use the unpatched compiler instead.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TC="$ROOT/toolchain/${BT_TOOLCHAIN:-msvc5-sp3}"
[ -f "$TC/BIN/CL.EXE" ] || { echo "Toolchain missing, run tools/setup_toolchain.sh" >&2; exit 1; }

winpath() { echo "Z:${1//\//\\}"; }

export WINEPREFIX="$ROOT/toolchain/wineprefix" WINEDEBUG=-all
# Keep an existing prefix's architecture: setups made before this change have a
# win32 prefix, which Wine refuses to run as win64. New prefixes are win64,
# which wow64-only Wine (Wine 11 on Fedora, for one) requires and which runs the
# 32-bit compiler on other Wine builds too.
if [ -z "${WINEARCH:-}" ]; then
    WINEARCH="$(sed -n 's/^#arch=//p' "$WINEPREFIX/system.reg" 2>/dev/null | head -n 1 || true)"
fi
export WINEARCH="${WINEARCH:-win64}"
export INCLUDE="$(winpath "$TC/INCLUDE")" LIB="$(winpath "$TC/LIB")"

tool="$(basename "$0")"
case "$tool" in
    wlink) exe=LINK.EXE ;;
    *) exe=CL.EXE ;;
esac
# Wine's server and helper processes inherit the compiler's stdout and stderr
# and hold them until they exit, so a caller capturing the output through a
# pipe (check.py) waited about 1.3 s per compile. Send the output to a file
# instead, and print it once the compiler has exited.
out="$(mktemp)"
trap 'rm -f "$out"' EXIT
rc=0
wine "$TC/BIN/$exe" /nologo "$@" >"$out" 2>&1 </dev/null || rc=$?
cat "$out"
exit "$rc"
