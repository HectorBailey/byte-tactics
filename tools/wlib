#!/usr/bin/env bash
# Run the VC++ 5.0 librarian (LIB.EXE) under Wine.
# Usage: tools/wlib /def:foo.def /out:foo.lib
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$ROOT/tools/wineenv.sh"
[ -f "$TC/BIN/LIB.EXE" ] || { echo "Toolchain missing, run tools/setup_toolchain.sh" >&2; exit 1; }

out="$(mktemp)"
trap 'rm -f "$out"' EXIT
rc=0
wine "$(winpath "$TC/BIN")/LIB.EXE" /nologo "$@" >"$out" 2>&1 </dev/null || rc=$?
cat "$out"
exit "$rc"
