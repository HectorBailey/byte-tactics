// The resources of TotalA.exe: its icon, its cursor and its version.
// Written by tools/resources.py --extract; compiled with RC.EXE and
// CVTRES.EXE by the same tool (docs/linking.md). The icon and cursor are
// Cavedog's art, which the repository does not hold: RC finds them on its
// include path, in the directory tools/resources.py gives it.

LANGUAGE 0x09, 0x01    // LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

32512 ICON DISCARDABLE "TotalA.ico"
103 CURSOR DISCARDABLE "TotalA.cur"

#define VS_VERSION_INFO 1

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 3,1,0,0
 PRODUCTVERSION 3,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Cavedog Entertainment\0"
            VALUE "FileDescription", "Total Annihilation\0"
            VALUE "FileVersion", "v3.1\0"
            VALUE "InternalName", "Total Annihilation\0"
            VALUE "LegalCopyright", "Copyright \251 1997\0"
            VALUE "OriginalFilename", "Totala.exe\0"
            VALUE "ProductName", "Cavedog Entertainment's Total Annihilation\0"
            VALUE "ProductVersion", "v3.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END
